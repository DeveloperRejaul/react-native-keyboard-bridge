{
  "name": "react-native-keyboard-bridge",
  "version": "0.1.1",
  "license": "MIT",
  "description": "Design a mobile system keyboard with ordinary React Native components. Single install: JS bridge, Android native module (autolinked), iOS native module (real React Native, Hermes+JSI+Fabric) + setup CLI, gestures, and word prediction all in one package.",
  "keywords": [
    "react-native",
    "keyboard",
    "custom-keyboard",
    "ime",
    "input-method",
    "keyboard-extension",
    "android",
    "ios",
    "swipe-typing",
    "word-prediction"
  ],
  "homepage": "https://keyboardbridge.github.io/",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeveloperRejaul/react-native-keyboard-bridge.git",
    "directory": "src"
  },
  "bugs": {
    "url": "https://github.com/DeveloperRejaul/react-native-keyboard-bridge/issues"
  },
  "author": {
    "name": "Rejaul Islam",
    "url": "https://github.com/DeveloperRejaul"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "react-native-keyboard-bridge": "bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "android",
    "ios",
    "react-native.config.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "yarn build",
    "test": "jest",
    "lint": "eslint core --ext .ts,.tsx"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.74"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.5.4"
  }
}
